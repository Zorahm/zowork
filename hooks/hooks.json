{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/refresh-guides.mjs"],
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-rules.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-pr.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-pr.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
